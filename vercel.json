{
  "installCommand": "pip install -r requirements.txt && cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{main.py,storage.py,thresholds.py,wifi_serial.py,webconfig.json}"
    }
  },
  "crons": [
    { "path": "/ai-report/generate-all", "schedule": "0 0 * * *" }
  ]
}
